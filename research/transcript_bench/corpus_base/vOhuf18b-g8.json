      "raw_segment_count": 1,
      "avg_logprob": -0.1547,
      "no_speech_prob": 0.0027,
      "word_count": 27
    },
    {
      "segment_id": 14,
      "start_time": 106.76,
      "end_time": 111.32000000000001,
      "text": "Because now it's like the same weight and same dimensions as a regular slab phone.",
      "duration": 4.56,
      "raw_segment_count": 1,
      "avg_logprob": -0.1169,
      "no_speech_prob": 0.0019,
      "word_count": 15
    },
    {
      "segment_id": 15,
      "start_time": 111.32000000000001,
      "end_time": 115.24000000000001,
      "text": "But in doing so, they had to make it really thin to do that, right?",
      "duration": 3.92,
      "raw_segment_count": 1,
      "avg_logprob": -0.1169,
      "no_speech_prob": 0.0019,
      "word_count": 15
    },
    {
      "segment_id": 16,
      "start_time": 115.24000000000001,
      "end_time": 120.84,
      "text": "In doing so, the tablet experience is noticeably worse than it was in previous generations.",

      "raw_segment_count": 2,
      "avg_logprob": -0.1701,
      "no_speech_prob": 0.0221,
      "word_count": 15
    },
    {
      "segment_id": 16,
      "start_time": 67.48,
      "end_time": 70.96000000000001,
      "text": "can praise the Lord, close without a gap.",

      "raw_segment_count": 2,
      "avg_logprob": -0.143,
      "no_speech_prob": 0.0095,
      "word_count": 13
    },
    {
      "segment_id": 6,
      "start_time": 26.28,
      "end_time": 31.88,
      "text": "So the actual volume being taken up is about the same. And yet, even with all of this,",

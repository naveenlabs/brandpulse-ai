      "raw_segment_count": 1,
      "avg_logprob": -0.1701,
      "no_speech_prob": 0.0221,
      "word_count": 12
    },
    {
      "segment_id": 15,
      "start_time": 64.04,
      "end_time": 67.48,
      "text": "It's a new hinge. One that for the very first time on a Samsung Flip",

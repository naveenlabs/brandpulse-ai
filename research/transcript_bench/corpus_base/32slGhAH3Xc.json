      "raw_segment_count": 3,
      "avg_logprob": -0.143,
      "no_speech_prob": 0.0095,
      "word_count": 17
    },
    {
      "segment_id": 4,
      "start_time": 18.72,
      "end_time": 21.96,
      "text": "And yeah, this is more compact, it folds, right?",
      "duration": 3.24,
      "raw_segment_count": 1,
      "avg_logprob": -0.143,
      "no_speech_prob": 0.0095,
      "word_count": 9
    },
    {
      "segment_id": 5,
      "start_time": 21.96,
      "end_time": 26.28,
      "text": "Well, not really. I mean, it is shorter, but it is also thicker.",

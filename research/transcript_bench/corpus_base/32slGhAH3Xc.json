      "raw_segment_count": 1,
      "avg_logprob": -0.1701,
      "no_speech_prob": 0.0221,
      "word_count": 8
    },
    {
      "segment_id": 17,
      "start_time": 70.96000000000001,
      "end_time": 75.88,
      "text": "Well, there is a tiny little hole here, but it's basically goupless. And this is a big deal.",

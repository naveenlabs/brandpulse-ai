      "raw_segment_count": 2,
      "avg_logprob": -0.143,
      "no_speech_prob": 0.0095,
      "word_count": 17
    },
    {
      "segment_id": 3,
      "start_time": 14.120000000000001,
      "end_time": 18.72,
      "text": "and deplete about 20% faster. There's less room for calling, so the chip won't perform as well.",

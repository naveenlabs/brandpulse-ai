      "raw_segment_count": 2,
      "avg_logprob": -0.1169,
      "no_speech_prob": 0.0095,
      "word_count": 18
    },
    {
      "segment_id": 7,
      "start_time": 31.88,
      "end_time": 37.0,
      "text": "why am I drawn to the Z Flip 5 so much? Why is it that my curiosity was so sparked",

      "raw_segment_count": 2,
      "avg_logprob": -0.1701,
      "no_speech_prob": 0.0221,
      "word_count": 20
    },
    {
      "segment_id": 19,
      "start_time": 80.12,
      "end_time": 83.32,
      "text": "but it also creates less room for rogue particles",

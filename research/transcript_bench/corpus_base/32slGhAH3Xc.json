      "no_speech_prob": 0.0221,
      "word_count": 9
    },
    {
      "segment_id": 20,
      "start_time": 83.32,
      "end_time": 87.72000000000001,
      "text": "and pocket dust to just find their way inside. Which, trust me, use any folding phone",

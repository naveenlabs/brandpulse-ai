# Copy this file to .env and fill in your values. Never commit .env to git.

# Required: YouTube Data API v3 key (comments, video search, video details).
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional. Leave these commented out to use the values the project measured and
# adopted; each line shows the code's default. Ollama is always local.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_NUM_CTX=4096
# ANALYST_NUM_CTX=6144
# WHISPER_MODEL_SIZE=large-v3-turbo
# VOCAL_MODEL_ID=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim

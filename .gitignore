# Hero-size stills (h/): build_frames.py still derives them, but no page
# requests one, and they are two thirds of the bytes. Kept on disk.
interface/static/frames/*/h/

# Two videos no page uses any more (hero.mp4, close.mp4 and their posters).
# Kept on disk; `npm run build` still copies them into interface/static/media.
interface/ui/public/media/
interface/static/media/

# Model weights. Whole folders, not only the weight files: the pipeline picks
# the fine-tuned comment model when models/comment_sentiment_ft/config.json
# exists, so a folder committed without its weights would load nothing.
# README, "Models", says how to install them.
models/comment_sentiment_ft/
models/comment_sentiment_ft.previous-*/
models/.comment_sentiment_ft.*/
models/.download.*/
research/comment_bench/v2/finetuned/
wav2vec2_checkpoints/
*.pt
*.pth

# Front-end dependencies and scratch space
interface/ui/node_modules/
interface/ui/_scratch/

# Retired interface, design exports and raw screenshots: kept on disk, not part
# of the product
_retired_ui/
Landing Page/
interface/ui/comps/out/
evaluation/user_eval/shots_raw/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# macOS
.DS_Store

# pytest
.pytest_cache/
.coverage
htmlcov/

# Facial bench — regenerable artefacts (crops, detections, predictions)
research/facial_bench/crops/
research/facial_bench/detections/
research/facial_bench/predictions/
research/facial_bench/*_log.txt

# Kept on disk, not published (author's decision, 27 Sep 2026): the written
# report and its drafts.
final_report/
evaluation/ui_evidence/report_drafts/

# Real names behind the pilot pseudonyms; stays on the project owner's machine.
evaluation/user_pilot/participants.local.txt

# Not part of the published project (author's decision, 27 Sep 2026), kept on
# disk: figures made for the written report and the script that draws the
# inclusive-design ones; design boards and captures of earlier interfaces; an
# old copy of a report from before outputs/ existed.
diagrams/
evaluation/ui_evidence/shoot_a11y_figures.py
interface/ui/comps/
evaluation/ui_evidence/motion/
evaluation/ui_evidence/motion.py
evaluation/ui_evidence/states.py
evaluation/ui_evidence/states.json
evaluation/ui_evidence/shots/*
!evaluation/ui_evidence/shots/a11y/
/Apple (Iphone 17 Pro Max).json

# Kept on disk, not published (27 Sep 2026): the development log and the
# working rules (the product rules are in README, "Engineering rules"), two
# superseded interface plans, a check for a report that no longer exists, raw
# run logs, a superseded and a duplicate measurement snapshot, and pages or
# tables that a tracked script rebuilds byte for byte (README, "What is where").
/CHANGES.md
/PROJECT_RULES.md
/INTERFACE_DESIGN.md
interface/ui/DESIGN_PLAN_V3.md
evaluation/ui_evidence/verify_broll_hallucination.py
evaluation/ui_evidence/broll_hallucination.json
evaluation/ui_evidence/ui_measurements.after.json
evaluation/ui_evidence/ui_measurements.2026-09-21.json
research/comment_bench/v2/analysis/_llama_run.log
research/comment_bench/v2/analysis/browse_model_predictions.csv
research/facial_bench/v2/acquire_log.txt
research/facial_bench/v2/acquire_stdout.txt
research/facial_bench/v2/damping_facial_log.txt
research/facial_bench/v2/run_v2_log.txt
research/vocal_bench/ab_cache/run.log
research/whisper_bench/type_here.html
evaluation/user_eval/BrandPulse_Evaluation.html

# Anonymised participant responses remain local. The public repository contains
# the instruments, aggregate scores and findings, but not individual responses.
/evaluation/user_pilot/RESPONSES.md
/evaluation/user_eval/RESPONSES.md

